    "textLink.foreground": "#4b92e7",
    "textLink.activeForeground": "#4b92e7",
    "textPreformat.foreground": "#d9dce5",
    "textBlockQuote.background": "#ffffff0b",
    "textCodeBlock.background": "#ffffff0b",
    "button.background": "#2f75cb",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#2a69b7",
    "button.secondaryBackground": "#ffffff17",
    "button.secondaryForeground": "#d9dce5",
    "button.secondaryHoverBackground": "#ffffff1f",
    "button.border": "#00000000",
    "badge.background": "#2f75cb",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#2f75cb",
    "input.background": "#ffffff10",
    "input.border": "#ffffff14",
    "input.foreground": "#e6e8ee",
    "input.placeholderForeground": "#8a90a0",
    "inputOption.activeBorder": "#4b92e7",
    "inputOption.activeBackground": "#2f75cb33",
    "inputValidation.errorBorder": "#ff8a8a",
    "inputValidation.warningBorder": "#c88800",
    "inputValidation.infoBorder": "#4b92e7",
    "dropdown.background": "#17191f",
    "dropdown.border": "#ffffff14",
    "dropdown.foreground": "#e6e8ee",
    "checkbox.background": "#ffffff10",
    "checkbox.border": "#ffffff14",
    "list.activeSelectionBackground": "#ffffff24",
    "list.activeSelectionForeground": "#f1f2f6",
    "list.inactiveSelectionBackground": "#ffffff17",
    "list.hoverBackground": "#ffffff0b",
    "list.focusOutline": "#4b92e7",
    "list.highlightForeground": "#4b92e7",
    "list.errorForeground": "#ff8a8a",
    "list.warningForeground": "#c88800",
    "tree.indentGuidesStroke": "#ffffff14",
    "activityBar.background": "#17191f",
    "activityBar.foreground": "#e6e8ee",
    "activityBar.inactiveForeground": "#7d8392",
    "activityBar.activeBorder": "#4b92e7",
    "activityBar.border": "#ffffff0d",
    "activityBarBadge.background": "#2f75cb",
    "activityBarBadge.foreground": "#ffffff",
    "sideBar.background": "#17191f",
    "sideBar.foreground": "#d9dce5",
    "sideBar.border": "#ffffff0d",
    "sideBarTitle.foreground": "#e6e8ee",
    "sideBarSectionHeader.background": "#17191f",
    "sideBarSectionHeader.foreground": "#e6e8ee",
    "sideBarSectionHeader.border": "#ffffff0d",
    "titleBar.activeBackground": "#181a20",
    "titleBar.activeForeground": "#d9dce5",
    "titleBar.inactiveBackground": "#181a20",
    "titleBar.inactiveForeground": "#7d8392",
    "titleBar.border": "#ffffff0d",
    "menubar.selectionBackground": "#ffffff1f",
    "menu.background": "#17191f",
    "menu.foreground": "#e6e8ee",
    "menu.selectionBackground": "#ffffff1f",
    "menu.selectionForeground": "#f1f2f6",
    "menu.separatorBackground": "#ffffff14",
    "menu.border": "#ffffff14",
    "commandCenter.background": "#ffffff10",
    "commandCenter.border": "#ffffff14",
    "commandCenter.foreground": "#d9dce5",
    "commandCenter.activeBackground": "#ffffff17",
    "editorGroupHeader.tabsBackground": "#181a20",
    "editorGroupHeader.tabsBorder": "#ffffff0d",
    "editorGroup.border": "#ffffff0d",
    "tab.activeBackground": "#1c1e25",
    "tab.activeForeground": "#f1f2f6",
    "tab.inactiveBackground": "#181a20",
    "tab.inactiveForeground": "#8a90a0",
    "tab.border": "#181a20",
    "tab.activeBorderTop": "#4b92e7",
    "tab.hoverBackground": "#ffffff0b",
    "tab.unfocusedActiveBorderTop": "#ffffff14",
    "breadcrumb.foreground": "#8a90a0",
    "breadcrumb.focusForeground": "#e6e8ee",
    "breadcrumb.background": "#1c1e25",
    "editor.background": "#1c1e25",
    "editor.foreground": "#e6e8ee",
    "editorLineNumber.foreground": "#7d8392b3",
    "editorLineNumber.activeForeground": "#d9dce5",
    "editorCursor.foreground": "#4b92e7",
    "editor.selectionBackground": "#2f75cb59",
    "editor.inactiveSelectionBackground": "#2f75cb2e",
    "editor.selectionHighlightBackground": "#2f75cb26",
    "editor.wordHighlightBackground": "#2f75cb26",
    "editor.findMatchBackground": "#ee650f66",
    "editor.findMatchHighlightBackground": "#c8880040",
    "editor.lineHighlightBackground": "#ffffff0b",
    "editor.lineHighlightBorder": "#00000000",
    "editorIndentGuide.background1": "#ffffff14",
    "editorIndentGuide.activeBackground1": "#ffffff1f",
    "editorWhitespace.foreground": "#ffffff1f",
    "editorRuler.foreground": "#ffffff14",
    "editorBracketMatch.background": "#2f75cb26",
    "editorBracketMatch.border": "#4b92e780",
    "editorError.foreground": "#ff8a8a",
    "editorWarning.foreground": "#c88800",
    "editorInfo.foreground": "#4b92e7",
    "editorGutter.addedBackground": "#7ed99c",
    "editorGutter.modifiedBackground": "#4b92e7",
    "editorGutter.deletedBackground": "#ff8a8a",
    "editorWidget.background": "#17191f",
    "editorWidget.border": "#ffffff14",
    "editorHoverWidget.background": "#17191f",
    "editorHoverWidget.border": "#ffffff14",
    "editorSuggestWidget.background": "#17191f",
    "editorSuggestWidget.border": "#ffffff14",
    "editorSuggestWidget.selectedBackground": "#ffffff24",
    "editorSuggestWidget.highlightForeground": "#4b92e7",
    "quickInput.background": "#17191f",
    "quickInputList.focusBackground": "#ffffff24",
    "pickerGroup.foreground": "#4b92e7",
    "pickerGroup.border": "#ffffff14",
    "keybindingLabel.background": "#ffffff10",
    "keybindingLabel.border": "#ffffff14",
    "keybindingLabel.bottomBorder": "#ffffff14",
    "keybindingLabel.foreground": "#d9dce5",
    "notifications.background": "#17191f",
    "notifications.border": "#ffffff14",
    "notificationCenterHeader.background": "#17191f",
    "panel.background": "#17191f",
    "panel.border": "#ffffff0d",
    "panelTitle.activeBorder": "#4b92e7",
    "panelTitle.activeForeground": "#e6e8ee",
    "panelTitle.inactiveForeground": "#8a90a0",
    "statusBar.background": "#181a20",
    "statusBar.foreground": "#8a90a0",
    "statusBar.border": "#ffffff0d",
    "statusBar.noFolderBackground": "#181a20",
    "statusBar.debuggingBackground": "#c74c00",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBarItem.hoverBackground": "#ffffff1f",
    "statusBarItem.remoteBackground": "#2f75cb",
    "statusBarItem.remoteForeground": "#ffffff",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#ffffff14",
    "scrollbarSlider.hoverBackground": "#ffffff1f",
    "scrollbarSlider.activeBackground": "#ffffff24",
    "terminal.background": "#17191f",
    "terminal.foreground": "#e6e8ee",
    "terminalCursor.foreground": "#4b92e7",
    "terminal.selectionBackground": "#2f75cb59",
    "gitDecoration.modifiedResourceForeground": "#c88800",
    "gitDecoration.untrackedResourceForeground": "#7ed99c",
    "gitDecoration.addedResourceForeground": "#7ed99c",
    "gitDecoration.deletedResourceForeground": "#ff8a8a",
    "gitDecoration.ignoredResourceForeground": "#7d8392",
    "gitDecoration.conflictingResourceForeground": "#d96ba0",
    "welcomePage.tileBackground": "#ffffff0b",
    "welcomePage.tileHoverBackground": "#ffffff10",
    "welcomePage.tileBorder": "#ffffff14",
    "walkThrough.embeddedEditorBackground": "#17191f",
    "terminal.ansiBlack": "#1c1e25",
    "terminal.ansiBrightBlack": "#7d8392",
    "terminal.ansiRed": "#ff8a8a",
    "terminal.ansiBrightRed": "#ffa3a3",
    "terminal.ansiGreen": "#7ed99c",
    "terminal.ansiBrightGreen": "#9ae6b4",
    "terminal.ansiYellow": "#e5c07b",
    "terminal.ansiBrightYellow": "#f0d398",
    "terminal.ansiBlue": "#4b92e7",
    "terminal.ansiBrightBlue": "#78aef0",
    "terminal.ansiMagenta": "#b37bc6",
    "terminal.ansiBrightMagenta": "#c99ad6",
    "terminal.ansiCyan": "#399cae",
    "terminal.ansiBrightCyan": "#5fb7c7",
    "terminal.ansiWhite": "#d9dce5",
    "terminal.ansiBrightWhite": "#f1f2f6"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7d8392",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#b37bc6"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace",
        "punctuation"
      ],
      "settings": {
        "foreground": "#8a90a0"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#7ed99c"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class"
      ],
      "settings": {
        "foreground": "#d96ba0"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ee650f"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#4b92e7"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#399cae"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.definition.variable",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#e6e8ee"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#d9dce5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#8fb6ea"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#ec6271"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#c88800"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#c88800"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "#399cae"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#4b92e7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#e6e8ee",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e6e8ee",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#4b92e7"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#7ed99c"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff8a8a"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#c88800"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff8a8a"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#4b92e7",
    "method": "#4b92e7",
    "class": "#399cae",
    "interface": "#399cae",
    "type": "#399cae",
    "enum": "#399cae",
    "typeParameter": "#399cae",
    "namespace": "#399cae",
    "parameter": "#d9dce5",
    "property": "#8fb6ea",
    "enumMember": "#ee650f",
    "variable": "#e6e8ee",
    "variable.readonly": "#ee650f",
    "keyword": "#b37bc6",
    "decorator": "#c88800",
    "regexp": "#d96ba0"
  }
}
