    "textLink.activeForeground": "#2663a9",
    "textPreformat.foreground": "#2b2f37",
    "textBlockQuote.background": "#00000009",
    "textCodeBlock.background": "#00000009",
    "button.background": "#2f75cb",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#2a69b7",
    "button.secondaryBackground": "#00000012",
